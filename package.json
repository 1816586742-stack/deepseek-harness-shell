{
  "name": "deepseek-harness-shell",
  "version": "0.1.0",
  "description": "Community desktop shell for DeepSeek Harness (dsh) — Electron, cross-platform.",
  "type": "module",
  "main": "./out/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
